# ==============================================================================
# TapOnce Environment Variables Template
# ==============================================================================
# HOW TO GET YOUR FREE RAZORPAY TEST KEYS:
# 1. Sign up / Log in to Razorpay Dashboard (https://dashboard.razorpay.com). No business KYC required for Test Mode.
# 2. In the top navbar, ensure the "Test Mode" toggle is switched ON.
# 3. Go to Account & Settings -> API Keys (under Website & App Settings).
# 4. Click "Generate Test Key" (or regenerate if needed) to get your Key ID and Key Secret.
# 5. Paste the Key ID in both RAZORPAY_KEY_ID and NEXT_PUBLIC_RAZORPAY_KEY_ID below.
# 6. Paste the Key Secret in RAZORPAY_KEY_SECRET.
# 7. For Webhooks: Settings -> Webhooks -> Add New Webhook with URL: http://localhost:3000/api/payments/webhook
#    (or your live domain in production), choose events: payment.captured, payment.failed, and copy secret to RAZORPAY_WEBHOOK_SECRET.
# ==============================================================================

# Database connection (SQLite local file for dev, hosted PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Server-side Razorpay credentials (NEVER expose to client)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Client-side Razorpay Key ID (safe for browser Checkout widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
